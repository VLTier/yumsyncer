# ============================================
# Craig Discord Audio Exporter Configuration
# ============================================
# Copy this file to .env and configure your settings

# ----------------------
# Remote Server Settings
# ----------------------

# Remote server hostname or IP address
REMOTE_HOST=your.server.com

# SSH username
REMOTE_USER=ubuntu

# SSH port (default: 22)
REMOTE_PORT=22

# ----------------------
# SSH Authentication
# ----------------------

# Path to your SSH private key on the HOST machine
# This file will be mounted into the container
SSH_KEY_HOST_PATH=/home/user/.ssh/id_rsa

# Alternative: Path inside the container (advanced users only)
# SSH_KEY_PATH=/ssh/id_rsa

# ----------------------
# Craig Installation Path
# ----------------------

# Path where Craig Discord bot is installed on the remote server
# Default assumes installation following official instructions at https://craig.chat
# Use ~ for home directory or provide full path
CRAIG_INSTALL_PATH=~/craig

# Path to Craig's recordings directory (optional - defaults to CRAIG_INSTALL_PATH/rec)
# Craig stores all audio recordings in the 'rec' subdirectory of the installation
# CRAIG_REC_PATH=~/craig/rec

# ----------------------
# Export Configuration
# ----------------------

# Local directory where audio files will be exported (on HOST machine)
# This directory will be created if it doesn't exist
EXPORT_HOST_PATH=./export

# Audio file extensions to export (comma-separated, no spaces)
AUDIO_EXTENSIONS=mp3,wav,ogg,flac,m4a,aac,opus,webm

# ----------------------
# Sync Settings
# ----------------------

# Sync interval in seconds (default: 3600 = 1 hour)
# How long to wait between sync operations
SYNC_INTERVAL=3600

# Run once and exit (true/false)
# Set to true if you want to run the export once and stop
# Set to false for continuous syncing
RUN_ONCE=false

# ----------------------
# Other Settings
# ----------------------

# Timezone for the container (optional)
TZ=UTC
